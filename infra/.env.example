# ---- Copy to infra/.env and adjust. Never commit the real .env ----

# General
COMPOSE_PROJECT_NAME=pfm
TZ=Asia/Dubai

# PostgreSQL
POSTGRES_USER=pfm
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=pfm
# App DB schema and Keycloak schema live in the same instance
APP_DB_SCHEMA=pfm
KEYCLOAK_DB_SCHEMA=keycloak

# DB admin GUI (pgAdmin, dev utility at http://localhost/pgadmin)
PGADMIN_EMAIL=admin@pfm.local
PGADMIN_PASSWORD=change-me-pgadmin

# Backend
BACKEND_SECRET_KEY=change-me-secret
DATABASE_URL=postgresql+psycopg://pfm:change-me-postgres@db:5432/pfm
# Most transactions are entered in this currency...
APP_DEFAULT_TXN_CURRENCY=AED
# ...but reports/roll-ups (cash position, projection, net worth) are computed in this one.
APP_REPORTING_CURRENCY=USD
LLM_MASTER_ENABLED=false

# Local admin fallback (Session 815, Batch 9): a Keycloak-independent admin login
# so you can always sign in even when Keycloak is down. Seeded once (hashed) on
# first run; change it in-app afterwards (login screen → "Change password").
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin

# Local LLM (Ollama). Used to seed a default llm_provider (kind=ollama).
# After first start, pull a model:  docker compose exec ollama ollama pull llama3.2
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Read-only role for the SQL console (Decision #10)
SQL_READONLY_USER=pfm_readonly
SQL_READONLY_PASSWORD=change-me-readonly

# Keycloak
# KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD are the master-realm admin creds. They
# are used both to log in to the Keycloak console AND by the backend's Keycloak
# Admin API client to provision users/roles (Users screen). Change for real use.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-kc-admin
KEYCLOAK_REALM=pfm
KEYCLOAK_CLIENT_ID=pfm-frontend
KC_HOSTNAME=localhost

# MinIO (object storage)
MINIO_ROOT_USER=pfm-minio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=pfm-documents

# Frontend
VITE_API_BASE_URL=/api
VITE_KEYCLOAK_URL=/auth
VITE_KEYCLOAK_REALM=pfm
VITE_KEYCLOAK_CLIENT_ID=pfm-frontend